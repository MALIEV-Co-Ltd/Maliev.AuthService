{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.Watch.BrowserRefresh": "None",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Watch": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServiceName": "AuthService",
  "Jwt": {
    "Issuer": "https://api.maliev.com",
    "Audience": "https://api.maliev.com"
  },
  "CustomerService": {
    "ValidationEndpoint": "/customers/v1/validate",
    "ValidationTimeoutSeconds": 30
  },
  "EmployeeService": {
    "ValidationEndpoint": "/employee/v1/auth/validate",
    "ValidationTimeoutSeconds": 30
  },
  "Services": {
    "IAMService": {
      "BaseUrl": "http://maliev-iamservice-api"
    },
    "CustomerService": {
      "BaseUrl": "http://maliev-customerservice-api"
    },
    "EmployeeService": {
      "BaseUrl": "http://maliev-employeeservice-api"
    }
  }
}
