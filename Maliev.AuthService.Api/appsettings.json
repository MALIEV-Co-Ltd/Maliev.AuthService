{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.Watch.BrowserRefresh": "None",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Watch": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://api.maliev.com",
    "Audience": "https://api.maliev.com",
    "AccessTokenExpirationInSeconds": 7200,
    "ServiceTokenExpirationInSeconds": 900
  },
  "CustomerService": {
    "ValidationEndpoint": "/customer/v1/customers/validate",
    "GoogleLinkOrRegisterEndpoint": "/customer/v1/customers/google/link-or-register",
    "PasswordResetRequestEndpoint": "/customer/v1/customers/password-reset/request",
    "PasswordResetConfirmEndpoint": "/customer/v1/customers/password-reset/confirm",
    "ValidationTimeoutSeconds": 30
  },
  "EmployeeService": {
    "ValidationEndpoint": "/employee/v1/auth/validate",
    "ValidationTimeoutSeconds": 30
  }
}
