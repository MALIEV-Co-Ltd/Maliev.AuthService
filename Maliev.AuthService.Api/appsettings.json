{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Jwt": {
    "Issuer": "https://auth.maliev.com",
    "Audience": "maliev-services",
    "SigningKey": "REPLACE_WITH_ECDSA_P256_PRIVATE_KEY_PEM",
    "AccessTokenLifetimeSeconds": 900,
    "RefreshTokenLifetimeSeconds": 2592000
  },
  "ExternalServices": {
    "CustomerServiceUrl": "http://customer-service:8080/api/v1",
    "EmployeeServiceUrl": "http://employee-service:8080/api/v1",
    "TimeoutMs": 5000,
    "MaxRetries": 3,
    "RetryDelayMs": 500
  },
  "RateLimit": {
    "LoginAttemptLimit": 5,
    "WindowSeconds": 300
  },
  "CircuitBreaker": {
    "FailureThreshold": 5,
    "DurationOfBreakSeconds": 30,
    "SamplingDurationSeconds": 60,
    "MinimumThroughput": 10
  },
  "Cache": {
    "DefaultTTLSeconds": 300,
    "ValidationCacheTTLSeconds": 600,
    "MaxEntries": 10000,
    "EnableCompression": false
  },
  "CorrelationId": {
    "HeaderName": "X-Correlation-Id",
    "IncludeInResponse": true,
    "UpdateLogContext": true
  },
  "Database": {
    "ConnectionString": "Server=localhost;Port=5432;Database=auth_db;User Id=postgres;Password=postgres;",
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false,
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 30
  },
  "HealthChecks": {
    "LivenessPath": "/auth/liveness",
    "ReadinessPath": "/auth/readiness",
    "EnableDetailedErrors": false,
    "TimeoutSeconds": 5
  },
  "AllowedHosts": "*"
}
