{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore.Watch.BrowserRefresh": "None",
      "Microsoft.Hosting.Lifetime": "Information",
      "System": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://api.maliev.com",
    "Audience": "https://api.maliev.com"
  },
  "ExternalServices": {
    "CustomerService": {
      "ValidationEndpoint": "/customers/v1/validate",
      "TimeoutInSeconds": 30
    },
    "EmployeeService": {
      "ValidationEndpoint": "/employees/v1/validate",
      "TimeoutInSeconds": 30
    }
  }
}