{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.Watch.BrowserRefresh": "None",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.Watch": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://api.maliev.com",
    "Audience": "https://api.maliev.com",
    "AccessTokenExpirationInSeconds": 7200,
    "ServiceTokenExpirationInSeconds": 900
  },
  "GoogleIdentity": {
    "NonceLifetimeMinutes": 10,
    "Bindings": {
      "Employee": {
        "intranet": "IntranetBff"
      },
      "Customer": {
        "web": "WebBff",
        "quote-engine": "QuoteEngineBff"
      }
    },
    "Employee": {
      "HostedDomain": "maliev.com",
      "Audiences": {}
    },
    "Customer": {
      "Audiences": {}
    }
  },
  "Passkey": {
    "Enabled": false,
    "RpId": "maliev.com",
    "RpName": "MALIEV",
    "AllowedOrigins": [
      "https://maliev.com",
      "https://www.maliev.com",
      "https://make.maliev.com"
    ],
    "TimeoutMilliseconds": 300000,
    "ChallengeSize": 32,
    "CeremonyLifetimeMinutes": 5,
    "MaxOutstandingCeremoniesPerApplication": 512,
    "Bindings": {
      "web": {
        "ServiceName": "WebBff",
        "PrincipalType": "Customer"
      },
      "quote-engine": {
        "ServiceName": "QuoteEngineBff",
        "PrincipalType": "Customer"
      }
    }
  },
  "CustomerService": {
    "ValidationEndpoint": "/customer/v1/customers/validate",
    "GoogleLinkOrRegisterEndpoint": "/customer/v1/customers/google/link-or-register",
    "PasswordResetRequestEndpoint": "/customer/v1/customers/password-reset/request",
    "PasswordResetConfirmEndpoint": "/customer/v1/customers/password-reset/confirm",
    "ValidationTimeoutSeconds": 30
  },
  "EmployeeService": {
    "ValidationEndpoint": "/employee/v1/auth/validate",
    "ValidationTimeoutSeconds": 30
  }
}
