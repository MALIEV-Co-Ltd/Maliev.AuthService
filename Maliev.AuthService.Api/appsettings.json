{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://api.maliev.com",
    "Audience": "https://api.maliev.com"
  },
  "ExternalServices": {
    "CustomerService": {
      "ValidationEndpoint": "/customers/v1/validate",
      "TimeoutInSeconds": 30
    },
    "EmployeeService": {
      "ValidationEndpoint": "/employees/v1/validate",
      "TimeoutInSeconds": 30
    }
  }
} 