{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "JwtOptions": {
    "Issuer": "https://auth.maliev.com",
    "Audience": "maliev-services",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "ExternalValidation": {
    "CustomerServiceUrl": "http://maliev-customer-service:8080",
    "EmployeeServiceUrl": "http://maliev-employee-service:8080",
    "TimeoutSeconds": 5,
    "CircuitBreakerFailureThreshold": 3,
    "CircuitBreakerSamplingDurationSeconds": 30,
    "CircuitBreakerMinimumThroughput": 5,
    "CircuitBreakerBreakDurationSeconds": 30
  },
  "RateLimiting": {
    "FailedLoginAttempts": 5,
    "LockoutDurationMinutes": 15,
    "SlidingWindowMinutes": 15
  },
  "Redis": {
    "Configuration": "localhost:6379",
    "InstanceName": "AuthService:",
    "PubSubChannel": "auth:token-revocation"
  },
  "AllowedHosts": "*"
}
